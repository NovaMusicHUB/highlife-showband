# Required for the contact form (app/api/contact/route.ts) to actually send emails.
# 1. Create a free account at https://resend.com
# 2. Create an API key (Dashboard → API Keys) and paste it below / set it in
#    your hosting provider's environment variables.
RESEND_API_KEY=

# Optional overrides — sensible defaults are used if these are not set.

# Address that receives contact form submissions.
CONTACT_TO_EMAIL=contact@highlifeshowband.ro

# "From" address used when sending. Resend requires this domain to be
# verified in your Resend account (Dashboard → Domains → add highlifeshowband.ro
# and follow the DNS instructions). Until it's verified, leave this unset —
# the API route falls back to Resend's shared "onboarding@resend.dev" sender,
# which works without domain verification.
# CONTACT_FROM_EMAIL="Highlife Showband <formular@highlifeshowband.ro>"
